{
    // Synthetic N64 skin: comments outside strings, a thumbstick, C buttons as a pad,
    // a combo button, frontend buttons and an alternate layout. The "//" inside the
    // name string must survive.
    "name": "N64 Comments // Test",
    "identifier": "com.emuskins.test.n64",
    "gameTypeIdentifier": "com.rileytestut.delta.game.n64",
    "representations": {
        "iphone": {
            "edgeToEdge": {
                "portrait": {
                    "assets": { "resizable": "Portrait.pdf" },
                    "items": [
                        { "inputs": { "up": "analogStickUp", "down": "analogStickDown", "left": "analogStickLeft", "right": "analogStickRight" },
                          "frame": { "x": 20, "y": 60, "width": 80, "height": 80 },
                          "thumbstick": { "name": "thumb.pdf", "width": 60, "height": 60 } },
                        { "inputs": { "up": "up", "down": "down", "left": "left", "right": "right" },
                          "frame": { "x": 20, "y": 180, "width": 120, "height": 120 } },
                        { "inputs": { "up": "cUp", "down": "cDown", "left": "cLeft", "right": "cRight" },
                          "frame": { "x": 200, "y": 180, "width": 100, "height": 100 }, "extendedEdges": { "top": 0, "bottom": 0, "left": 0, "right": 0 } },
                        { "inputs": ["a"], "frame": { "x": 240, "y": 60, "width": 50, "height": 50 } },
                        { "inputs": ["b"], "frame": { "x": 180, "y": 90, "width": 50, "height": 50 } },
                        { "inputs": ["a", "b"], "frame": { "x": 240, "y": 120, "width": 50, "height": 30 }, "extendedEdges": { "right": 20 } },
                        { "inputs": ["z"], "frame": { "x": 0, "y": 0, "width": 100, "height": 30 } },
                        { "inputs": ["menu"], "frame": { "x": 150, "y": 10, "width": 20, "height": 20 } },
                        { "inputs": ["toggleFastForward"], "frame": { "x": 150, "y": 40, "width": 20, "height": 20 } },
                        { "inputs": ["quickSave"], "frame": { "x": 150, "y": 70, "width": 20, "height": 20 } },
                        { "inputs": ["quickLoad"], "frame": { "x": 150, "y": 100, "width": 20, "height": 20 } },
                        { "inputs": ["toggleAltRepresentations"], "frame": { "x": 150, "y": 130, "width": 20, "height": 20 } },
                        { "inputs": ["touchScreenX", "touchScreenY"], "frame": { "x": 0, "y": 320, "width": 320, "height": 10 } }
                    ],
                    "mappingSize": { "width": 320, "height": 340 },
                    "extendedEdges": { "top": 10, "bottom": 10, "left": 10, "right": 10 }
                },
                "landscape": {
                    "assets": { "resizable": "Landscape.pdf" },
                    "items": [
                        { "inputs": ["a"], "frame": { "x": 700, "y": 200, "width": 60, "height": 60 } },
                        { "inputs": ["toggleAltRepresentations"], "frame": { "x": 400, "y": 10, "width": 20, "height": 20 } }
                    ],
                    "screens": [ { "inputFrame": { "x": 0, "y": 0, "width": 320, "height": 240 },
                                   "outputFrame": { "x": 156, "y": 0, "width": 500, "height": 375 } } ],
                    "mappingSize": { "width": 812, "height": 375 },
                    "translucent": false
                }
            }
        }
    },
    "altRepresentations": {
        "iphone": {
            "edgeToEdge": {
                "portrait": {
                    "assets": { "resizable": "PortraitAlt.pdf" },
                    "items": [
                        { "inputs": ["a"], "frame": { "x": 240, "y": 60, "width": 50, "height": 50 } },
                        { "inputs": ["toggleAltRepresentations"], "frame": { "x": 150, "y": 130, "width": 20, "height": 20 } }
                    ],
                    "mappingSize": { "width": 320, "height": 340 }
                }
            }
        }
    }
}
